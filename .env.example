# ---------------------------------------------------------------------------
# Sweety environment variables
# Copy this file to `.env` and replace the example secrets before deploying.
# ---------------------------------------------------------------------------

# Node environment: development | test | production
NODE_ENV=development

# API server
PORT=4000

# PostgreSQL connection used by the API (local docker-compose database)
DATABASE_URL=postgresql://sweety:sweety@localhost:5433/sweety

# Set to "true" when your hosted PostgreSQL provider requires SSL.
DATABASE_SSL=false

# A long, random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string

# Password hashing cost. 12 is a good production default; tests lower this.
BCRYPT_ROUNDS=12

# Send the session cookie only over HTTPS. Set true in production and false
# only for local HTTP development/docker demos.
COOKIE_SECURE=false

# Allowed frontend origin when the API and frontend are run separately.
CLIENT_URL=http://localhost:5173

# Optional: only needed when the React build calls an API on another origin.
# Leave blank for the local Vite proxy and the single-server Docker setup.
# VITE_API_URL=

# Separate database used only by the automated API tests. It is created
# automatically the first time `npm run test:server` runs.
TEST_DATABASE_URL=postgresql://sweety:sweety@localhost:5433/sweety_test

# ---------------------------------------------------------------------------
# Used by docker-compose.yml when starting the PostgreSQL container
# ---------------------------------------------------------------------------
POSTGRES_USER=sweety
POSTGRES_PASSWORD=sweety
POSTGRES_DB=sweety
